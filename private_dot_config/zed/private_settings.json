// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "close_on_file_delete": true,
  "restore_on_file_reopen": true,
  "scan_symlinks": "expanded",
  "file_scan_depth": 5,
  "file_finder": {
    "prefill_query_from_selection": true,
    "skip_focus_for_active_in_search": true,
    "include_ignored": "indexed",
    "file_icons": true
  },
  "command_palette": {
    "use_command_history": true
  },
  "seed_search_query_from_cursor": "always",
  "search_wrap": true,
  "use_smartcase_search": true,
  "search": {
    "search_on_type": true,
    "center_on_match": true,
    "regex": false,
    "include_ignored": false,
    "case_sensitive": false,
    "whole_word": false
  },
  "lsp_highlight_debounce": 75,
  "diagnostics": {
    "lsp_pull_diagnostics": {
      "debounce_ms": 50,
      "enabled": true
    },
    "inline": {
      "min_column": 0,
      "padding": 4,
      "update_debounce_ms": 150,
      "enabled": true
    },
    "include_warnings": true
  },
  "diagnostics_max_severity": "all",
  "prettier": {
    "allowed": true
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "lsp_results_location": "multi_buffer",
  "go_to_definition_scroll_strategy": "center",
  "go_to_definition_fallback": "find_all_references",
  "linked_edits": true,
  "enable_language_server": true,
  "drop_target_size": 0.2,
  "image_viewer": {
    "unit": "binary",
  },
  "modeline_lines": 5,
  "colorize_brackets": false,
  "extend_comment_on_newline": true,
  "middle_click_paste": true,
  "word_diff_enabled": true,
  "language_detection": true,
  "tasks": {
    "prefer_lsp": true,
    "enabled": true,
  },
  "lsp_document_colors": "inlay",
  "code_lens": "menu",
  "inlay_hints": {
    "scroll_debounce_ms": 50,
    "edit_debounce_ms": 700,
    "show_other_hints": true,
    "show_background": false,
    "show_parameter_hints": true,
    "show_type_hints": true,
    "show_value_hints": true,
    "enabled": true,
  },
  "completion_menu_item_kind": "symbol",
  "completion_detail_alignment": "left",
  "completion_menu_scrollbar": "never",
  "completions": {
    "lsp_insert_mode": "replace_suffix",
    "lsp_fetch_timeout_ms": 0,
    "lsp": true,
    "words_min_length": 3,
    "words": "fallback",
  },
  "show_completion_documentation": true,
  "show_completions_on_input": true,
  "show_whitespaces": "selection",
  "always_treat_brackets_as_autoclosed": true,
  "jsx_tag_auto_close": {
    "enabled": true,
  },
  "use_auto_surround": true,
  "use_autoclose": true,
  "use_on_type_format": true,
  "line_ending": "detect",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "on",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 1,
    "line_width": 1,
    "enabled": true,
  },
  "preferred_line_length": 80,
  "allow_rewrap": "in_comments",
  "soft_wrap_indent": "extra_one",
  "soft_wrap": "none",
  "auto_indent": "syntax_aware",
  "hard_tabs": false,
  "tab_size": 4,
  "vim": {
    "cursor_shape": {
      "visual": "block",
      "replace": "underline",
      "insert": "block",
      "normal": "block",
    },
    "show_edit_predictions_in_normal_mode": false,
    "highlight_on_yank_duration": 200,
    "gdefault": false,
    "use_regex_search": true,
    "use_smartcase_find": false,
    "toggle_relative_line_numbers": false,
    "use_system_clipboard": "always",
    "default_mode": "normal",
  },
  "toolbar": {
    "code_actions": true,
    "agent_review": true,
    "selections_menu": false,
    "quick_actions": true,
    "breadcrumbs": false,
  },
  "minimap": {
    "max_width_columns": 80,
    "current_line_highlight": "all",
    "display_in": "active_editor",
    "thumb_border": "left_open",
    "thumb": "always",
    "show": "never",
  },
  "inline_code_actions": true,
  "relative_line_numbers": "disabled",
  "gutter": {
    "min_line_number_digits": 4,
    "git_gutter_width": "default",
    "folds": true,
    "breakpoints": true,
    "runnables": true,
    "line_numbers": true,
  },
  "drag_and_drop_selection": {
    "delay": 300,
    "enabled": true,
  },
  "hover_popover_hiding_delay": 300,
  "hover_popover_sticky": true,
  "hover_popover_delay": 300,
  "hover_popover_enabled": true,
  "snippet_sort_order": "top",
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "autoscroll_on_clicks": false,
  "mouse_wheel_zoom": true,
  "scroll_sensitivity": 1.0,
  "horizontal_scroll_margin": 5.0,
  "vertical_scroll_margin": 3.0,
  "scroll_beyond_last_line": "off",
  "outline_panel": {
    "expand_outlines_with_depth": 100,
  },
  "excerpt_context_lines": 2,
  "expand_excerpt_lines": 5,
  "double_click_in_multibuffer": "select",
  "which_key": {
    "enabled": true,
  },
  "scrollbar": {
    "diagnostics": "all",
    "selected_symbol": false,
    "selected_text": false,
    "search_results": false,
    "git_diff": true,
    "cursors": false,
    "axes": {
      "vertical": true,
      "horizontal": true,
    },
    "show": "system",
  },
  "autosave": "on_window_change",
  "helix_mode": false,
  "vim_mode": false,
  "auto_install_extensions": {
    "ansible": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "codebook": true,
    "codeowners": true,
    "color-highlight": true,
    "comment": true,
    "comment-block-snippets": true,
    "css-variables": true,
    "deps-language-server": true,
    "dockerfile": true,
    "emmet": true,
    "emoji-completions": true,
    "env": true,
    "ghostty": true,
    "git-firefly": true,
    "github-actions": true,
    "github-actions-snippets": true,
    "gitignore-templates": true,
    "glsl": true,
    "helm": true,
    "html": true,
    "html-snippets": true,
    "import-cost-lsp": true,
    "java": true,
    "javascript-snippets": true,
    "json5": true,
    "k8s-crd-lsp": true,
    "kubernetes-snippets": true,
    "lorem-snippets": true,
    "markdown-snippets": true,
    "markdownlint": true,
    "openapi-lsp": true,
    "oxc": true,
    "path-server-lsp": true,
    "postgres-language-server": true,
    "pyrefly": true,
    "pytest-language-server": true,
    "python-snippets": true,
    "rainbow-csv": true,
    "rlsp-yaml": true,
    "scss": true,
    "sql": true,
    "terraform": true,
    "tflint": true,
    "todo-highlight-language-server": true,
    "toml": true,
    "tsgo": true,
    "typescript-snippets": true,
    "vitest-snippets": true,
    "vue": true,
    "vue-snippets": true,
    "wc-language-server": true,
    "xml": true,
  },
  "show_wrap_guides": true,
  "unnecessary_code_fade": 0.7,
  "current_line_highlight": "all",
  "rounded_selection": true,
  "selection_highlight": true,
  "hide_mouse": "on_typing_and_action",
  "cursor_shape": "bar",
  "cursor_animation": {
    "enabled": false,
  },
  "cursor_blink": true,
  "reduce_motion": "off",
  "multi_cursor_modifier": "alt",
  "use_display_p3": true,
  "text_rendering_mode": "grayscale",
  "mermaid_font_family": "SF Pro",
  "markdown_preview": {
    "max_width": 800.0,
    "limit_content_width": true,
    "open_markdown_files_in_preview": false,
    "heading_font_weight": 600.0,
    "font_size": 15.0,
    "code_font_family": "JetBrainsMono Nerd Font",
    "font_family": "SF Pro",
  },
  "agent_buffer_font_family": "SF Pro",
  "agent_buffer_font_size": 15.0,
  "agent_ui_font_size": 16.0,
  "agent_ui_font_family": "SF Pro",
  "ui_font_weight": 400.0,
  "buffer_font_weight": 400.0,
  "ui_font_family": "SF Pro",
  "buffer_line_height": "standard",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "suggest_extensions": false,
  "auto_update": false,
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": false,
    "restore_unsaved_buffers": false,
  },
  "on_new_window": "launchpad",
  "accessible_mode": false,
  "use_system_prompts": true,
  "use_system_path_prompts": true,
  "reveal_if_open": true,
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "redact_private_values": true,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "close_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
}
